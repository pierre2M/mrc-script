#!/bin/sh
# Garde locale : tout push passe par tools/publier.sh (seul l'état courant est publié).
# Installation : cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
[ "${MRC_PUBLIER:-}" = 1 ] && exit 0
echo "Push direct refusé : utilisez tools/publier.sh (seul l'état courant est publié)." >&2
exit 1
